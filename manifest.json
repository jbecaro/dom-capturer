{
  "manifest_version": 3,
  "name": "DOM Capturer",
  "version": "0.1.0",
  "description": "Capture full DOM elements as PNG screenshots.",
  "permissions": [
    "activeTab",
    "scripting",
    "debugger",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {}
}